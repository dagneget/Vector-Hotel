<Application x:Class="HRS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                
                <!-- NOCTURNAL Theme Custom Colors -->
                <ResourceDictionary>
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    
                    <!-- Core Backgrounds -->
                    <Color x:Key="AppBackground">#121212</Color>
                    <Color x:Key="SidebarBackground">#0C0C0C</Color>
                    <Color x:Key="CardBackground">#1E1E1E</Color>
                    <Color x:Key="CardHoverBackground">#252525</Color>
                    
                    <!-- Accents & Text -->
                    <Color x:Key="NocturnalAccent">#82ABFF</Color>
                    <Color x:Key="TextPrimary">#FFFFFF</Color>
                    <Color x:Key="TextSecondary">#8E8E8E</Color>
                    <Color x:Key="SuccessGreen">#2DCC70</Color>
                    <Color x:Key="DangerRed">#FF4B4B</Color>

                    <!-- Brushes -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackground}" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverBackground}" />
                    <SolidColorBrush x:Key="NocturnalAccentBrush" Color="{StaticResource NocturnalAccent}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
                    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />
                    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
