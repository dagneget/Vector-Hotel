<UserControl x:Class="HRS.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:RoomsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <!-- Left Side: Header & Grid -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Room Inventory" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="OPERATIONAL STATUS • ASSET MANAGEMENT • HOUSEKEEPING" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" Opacity="0.7" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="12" Height="45" Margin="0,0,15,0" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                        <Grid Width="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                     materialDesign:HintAssist.Hint="Search by room # or tier..."
                                     BorderThickness="0" 
                                     VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14">
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button Command="{Binding RegisterRoomCommand}" 
                            Visibility="{Binding CanManageRooms, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource LuminousAccentBrush}" Foreground="White" FontWeight="Black"
                            BorderThickness="0" Height="45" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ADD NEW ROOM" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Data Table -->
            <Border Grid.Row="1" Style="{StaticResource LuminousCardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          BorderThickness="0" Background="{DynamicResource CardBackgroundBrush}" Margin="20" RowHeight="75"
                          RowBackground="{DynamicResource CardBackgroundBrush}"
                          AlternatingRowBackground="{DynamicResource CardHoverBrush}">
                    <DataGrid.ItemContainerStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <EventSetter Event="MouseDoubleClick" Handler="OnRoomRowDoubleClick"/>
                        </Style>
                    </DataGrid.ItemContainerStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Black"/>
                            <Setter Property="Padding" Value="10,0,10,15"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="UNIT ID" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" Padding="15,8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoomNumber}" FontWeight="Black" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="FLOOR LEVEL" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding FloorNumber, StringFormat='Level {0}'}" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="MAIN WING" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ROOM CATEGORY" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding BasePrice, StringFormat=Starting at ${0:N0}/night}" FontSize="11" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="HOUSEKEEPING" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CleanStatus}" Value="Dirty">
                                                            <Setter Property="Background" Value="{DynamicResource DangerRedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CleanStatus}" Value="Maintenance">
                                                            <Setter Property="Background" Value="#F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        
                                         <ComboBox ItemsSource="{Binding DataContext.CleanStatusOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   IsEnabled="{Binding DataContext.CanManageRooms, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   SelectedItem="{Binding CleanStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource MaterialDesignComboBox}"
                                                  BorderThickness="0" FontWeight="Black" FontSize="13" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                  Width="110" VerticalAlignment="Center">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontWeight="Bold" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="AVAILABILITY" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="15,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACTIONS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.ViewRoomDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Height="35" Padding="12,0" Margin="0,0,5,0"
                                                Background="{DynamicResource LuminousAccentBrush}"
                                                Foreground="White"
                                                materialDesign:ButtonAssist.CornerRadius="8">
                                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.EditRoomCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanManageRooms, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="35" Padding="12,0"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                materialDesign:ButtonAssist.CornerRadius="8">
                                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Right Side: Details/Edit Panel -->
        <Border Grid.Column="1" Width="420" Background="{DynamicResource SidebarBackgroundBrush}" 
                Margin="30,0,0,0" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"
                Visibility="{Binding IsViewingDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.1" ShadowDepth="0"/>
            </Border.Effect>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Room Details"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Edit Room"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="VIEW ASSET INFORMATION"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="UPDATE ASSET DETAILS &amp; STATUS"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- VIEW MODE: Comprehensive Room Details -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <!-- Room Images Gallery -->
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" Height="140" Margin="0,0,0,20"
                                    BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                                <Grid>
                                    <TextBlock Text="No images available" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRoom.HasImages}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10">
                                        <ItemsControl ItemsSource="{Binding SelectedRoom.ImageUrls}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Margin="5,0" Width="120" Height="120">
                                                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Main Price Card -->
                            <Border Background="{DynamicResource LuminousAccentBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedRoom.Currency}" FontSize="10" FontWeight="Black" Foreground="White" Opacity="0.8" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="$" FontSize="24" FontWeight="Black" Foreground="White" VerticalAlignment="Top" Margin="0,5,2,0"/>
                                        <TextBlock Text="{Binding SelectedRoom.BasePricePerNight, StringFormat={}{0:N0}}" FontSize="48" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="/night" FontSize="14" FontWeight="Bold" Foreground="White" Opacity="0.8" VerticalAlignment="Bottom" Margin="5,0,0,8"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedRoom.CategoryName}" FontSize="14" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Special Pricing Tiers -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                                <StackPanel>
                                    <TextBlock Text="PRICING TIERS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Weekday -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="WEEKDAY" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedRoom.BasePricePerNight, StringFormat='${0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <!-- Weekend -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="WEEKEND" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedRoom.WeekendPrice, StringFormat='${0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource LuminousAccentBrush}"/>
                                        </StackPanel>
                                        <!-- Holiday -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="HOLIDAY" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedRoom.HolidayPrice, StringFormat='${0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerRedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Basic Info Row -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="ROOM #" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SelectedRoom.RoomNumber}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="FLOOR" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding SelectedRoom.FloorNumber, StringFormat='Level {0}'}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SIZE" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} m²">
                                                    <Binding Path="SelectedRoom.RoomSize" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Capacity & Bed Configuration -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                                <StackPanel>
                                    <TextBlock Text="CAPACITY &amp; BEDS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Max Guests -->
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="MAX GUESTS" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedRoom.MaxOccupancy}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" people" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Beds -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="BEDS" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedRoom.NumberOfBeds}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <!-- Bed Type -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="TYPE" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SelectedRoom.BedType}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <!-- Extra Bed -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                            <TextBlock Text="EXTRA BED" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} (${1:N0})">
                                                        <Binding Path="SelectedRoom.HasExtraBed" />
                                                        <Binding Path="SelectedRoom.ExtraBedPrice" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- All Status Indicators -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Availability -->
                                <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="AVAILABILITY" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedRoom.AvailabilityStatus}" Value="Occupied">
                                                            <Setter Property="Background" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedRoom.AvailabilityStatus}" Value="Reserved">
                                                            <Setter Property="Background" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedRoom.AvailabilityStatus}" Value="OutOfService">
                                                            <Setter Property="Background" Value="#6B7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SelectedRoom.AvailabilityStatus}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Clean Status -->
                                <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="CLEANING" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessGreenBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedRoom.CleanStatus}" Value="Dirty">
                                                                <Setter Property="Background" Value="{DynamicResource DangerRedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedRoom.CleanStatus}" Value="Maintenance">
                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <ComboBox ItemsSource="{Binding DataContext.CleanStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               IsEnabled="{Binding CanManageRooms}"
                                               SelectedItem="{Binding SelectedRoom.CleanStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource MaterialDesignComboBox}"
                                                      BorderThickness="0" FontWeight="Bold" FontSize="12" 
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                      Width="100" VerticalAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontWeight="Bold" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Operational -->
                                <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="OPERATIONAL" FontSize="8" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding SelectedRoom.OperationalStatus}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Amenities Section -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                                <StackPanel>
                                    <TextBlock Text="AMENITIES &amp; FEATURES" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding SelectedRoom.Amenities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="15" Padding="10,5" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No amenities listed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRoom.Amenities.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Additional Attributes -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,20" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                                <StackPanel>
                                    <TextBlock Text="ROOM ATTRIBUTES" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Smoking: {0}">
                                                        <Binding Path="SelectedRoom.SmokingAllowed" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Wheelchair: {0}">
                                                        <Binding Path="SelectedRoom.WheelchairAccessible" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="10,6">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="Pet Friendly: {0}">
                                                        <Binding Path="SelectedRoom.PetFriendly" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Staff Notes -->
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,20" Visibility="{Binding SelectedRoom.StaffNotes, Converter={StaticResource StringToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="STAFF NOTES" FontSize="9" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SelectedRoom.StaffNotes}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Edit Mode Form Fields -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="IDENTIFIER / ROOM #" FontWeight="Black" FontSize="11" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,12" />
                            <TextBox Text="{Binding FormRoomNumber}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15" Height="55" VerticalContentAlignment="Center"/>

                            <TextBlock Text="FLOOR ASSIGNMENT" FontWeight="Black" FontSize="11" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,12" />
                            <TextBox Text="{Binding FormFloor}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15" Height="55" VerticalContentAlignment="Center"/>

                            <TextBlock Text="ROOM CATEGORY" FontWeight="Black" FontSize="11" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,12" />
                            <ComboBox ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding FormSelectedType}" DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,15" Height="55"/>

                            <TextBlock Text="OPERATIONAL CONDITION" FontWeight="Black" FontSize="11" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,12" />
                            <ComboBox ItemsSource="{Binding CleanStatusOptions}" SelectedItem="{Binding FormCleanStatus}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,15" Height="55"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <!-- View Mode Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Button Content="CLOSE" Command="{Binding CancelEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource DividerBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="45" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="12"/>
                    </StackPanel>
                    
                    <!-- View Mode Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Button Content="EDIT ROOM" Command="{Binding StartEditCommand}" 
                                Visibility="{Binding CanManageRooms, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource MaterialDesignFlatButton}" Background="{DynamicResource LuminousAccentBrush}" Foreground="White" FontWeight="Black" Height="45" Padding="30,0" materialDesign:ButtonAssist.CornerRadius="12" />
                    </StackPanel>
                    
                    <!-- Edit Mode Buttons -->
                    <Button Content="DELETE" Command="{Binding DeleteRoomCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource DangerRedBrush}" FontWeight="Black" HorizontalAlignment="Left" Padding="0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="CANCEL" Command="{Binding CancelEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="{DynamicResource DividerBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" Height="45" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="12"/>
                        <Button Content="SAVE CHANGES" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="{DynamicResource LuminousAccentBrush}" Foreground="White" FontWeight="Black" Height="45" Padding="30,0" materialDesign:ButtonAssist.CornerRadius="12" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
