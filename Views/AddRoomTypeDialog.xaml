<Window x:Class="HRS.Views.AddRoomTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Add Room Type" 
        Height="350" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource AppBackgroundBrush}" 
            CornerRadius="20" 
            BorderThickness="1" 
            BorderBrush="{DynamicResource DividerBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" Color="Black" Opacity="0.25" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}" 
                    CornerRadius="20,20,0,0" 
                    Padding="25,20"
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{DynamicResource DividerBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ADD ROOM TYPE" 
                                   FontSize="20" 
                                   FontWeight="Black" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="CREATE A NEW ROOM CATEGORY" 
                                   FontSize="10" 
                                   FontWeight="Black" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   Margin="0,4,0,0" 
                                   Opacity="0.8"/>
                    </StackPanel>
                    
                    <Button Click="OnCloseClick" 
                            HorizontalAlignment="Right"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="36" Height="36"
                            Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="25,20">
                <StackPanel>
                    <TextBlock Text="Type Name *" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                    <TextBox x:Name="TypeNameTextBox"
                             materialDesign:HintAssist.Hint="e.g. Presidential Suite"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="50" Padding="12,10"/>

                    <TextBlock Text="Base Price *" FontSize="11" FontWeight="Bold" Margin="0,15,0,5" Opacity="0.7"/>
                    <TextBox x:Name="BasePriceTextBox"
                             materialDesign:HintAssist.Hint="e.g. 250"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="50" Padding="12,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBackgroundBrush}" 
                    CornerRadius="0,0,20,20" 
                    Padding="25,20"
                    BorderThickness="0,1,0,0" 
                    BorderBrush="{DynamicResource DividerBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" 
                            Click="OnCancelClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Height="45"
                            Padding="25,0"
                            Margin="0,0,12,0"
                            materialDesign:ButtonAssist.CornerRadius="10"/>
                    
                    <Button Content="CREATE" 
                            Click="OnCreateClick"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Background="{DynamicResource LuminousAccentBrush}"
                            Foreground="White"
                            FontWeight="Black"
                            Height="45"
                            Padding="30,0"
                            materialDesign:ButtonAssist.CornerRadius="10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
