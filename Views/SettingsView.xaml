<UserControl x:Class="HRS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:SettingsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="System Settings" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="ACCESS CONTROL • FINANCIAL POLICIES • DATABASE BACKUPS" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding BackupCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Backup" Margin="0,0,8,0" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="BACKUP" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Command="{Binding RestoreCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource DangerRedBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restore" Margin="0,0,8,0" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="RESTORE" FontWeight="Black" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Users Panel -->
            <Border Grid.Column="0" Style="{StaticResource LuminousCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Authorized Personnel" FontWeight="Black" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="LOGIN ACCESS CONTROL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        
                        <Button Command="{Binding DeleteUserCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource DangerRedBrush}" ToolTip="Delete Selected Staff">
                            <materialDesign:PackIcon Kind="Delete" Width="22" Height="22" />
                        </Button>
                    </Grid>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UsersList}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              BorderThickness="0" Background="Transparent" RowHeight="55" Margin="0,0,0,15">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="Padding" Value="0,0,0,10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="USER IDENTIFIER" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}" Margin="0,0,10,0">
                                                <materialDesign:PackIcon Kind="ShieldAccount" Foreground="{DynamicResource LuminousAccentBrush}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Username}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="ACCESS LEVEL" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Right">
                                            <Border Background="{DynamicResource LuminousAccentBrush}" Opacity="0.1" CornerRadius="6" />
                                            <TextBlock Text="{Binding Role}" FontSize="9" FontWeight="Black" Foreground="{DynamicResource LuminousAccentBrush}" Padding="10,4" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 2: Register New Staff Form -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,15" Opacity="0.5" />
                        <TextBlock Text="PROVISION NEW ACCOUNT" FontSize="11" FontWeight="Black" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,12" />
                        
                        <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Username" Style="{StaticResource MaterialDesignFilledTextBox}" Margin="0,0,0,10" Background="{DynamicResource AppBackgroundBrush}" />
                        
                        <PasswordBox x:Name="StaffPassword" materialDesign:HintAssist.Hint="Password" Style="{StaticResource MaterialDesignFilledPasswordBox}" Margin="0,0,0,10" Background="{DynamicResource AppBackgroundBrush}" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding FormRole}" materialDesign:HintAssist.Hint="Access Level" Style="{StaticResource MaterialDesignFilledComboBox}" Margin="0,0,10,0" Background="{DynamicResource AppBackgroundBrush}"/>
                            <Button Grid.Column="1" Command="{Binding AddUserCommand}" CommandParameter="{Binding ElementName=StaffPassword}" Style="{StaticResource MaterialDesignFlatButton}" Background="{DynamicResource LuminousAccentBrush}" Foreground="Black" FontWeight="Black" Padding="15,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,6,0" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="ADD" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Financial Overrides Panel -->
            <Border Grid.Column="2" Style="{StaticResource LuminousCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="Financial Policies" FontWeight="Black" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="TAX RATES • PAYMENT OVERRIDES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Tax Rate -->
                        <TextBlock Text="Tax Rate Configuration" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tax Rate" Style="{StaticResource MaterialDesignFilledTextBox}" Background="{DynamicResource AppBackgroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="%" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <Separator Margin="0,0,0,20" Background="{DynamicResource DividerBrush}" Opacity="0.3"/>

                        <!-- Toggles -->
                        <TextBlock Text="Policy Safeguards" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,15" />
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Require Full Payment Before Check-In" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding RequireFullPaymentBeforeCheckIn}" Style="{StaticResource MaterialDesignCheckBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Allow Partial Payments" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding AllowPartialPayments}" Style="{StaticResource MaterialDesignCheckBox}" />
                        </Grid>
                    </StackPanel>

                    <Button Grid.Row="2" Command="{Binding SaveSettingsCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="{DynamicResource LuminousAccentBrush}" Foreground="Black" FontWeight="Black" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="APPLY CHANGES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
