<UserControl x:Class="HRS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:SettingsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Users &amp; Audit Logs" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="SYSTEM SECURITY • ROLE MANAGEMENT • ACTIVITY AUDIT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Users Panel -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#252525" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="System Users" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,15"/>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UsersList}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              BorderThickness="0" Background="Transparent" RowHeight="50">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*" Foreground="White"/>
                            <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="*" Foreground="{DynamicResource NocturnalAccentBrush}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Audit Logs Panel -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#252525" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Live Security Audit Log" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,15"/>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogsList}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              BorderThickness="0" Background="Transparent" RowHeight="45">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding Timestamp, StringFormat=MMM dd yyyy - h:mm tt}" Width="150" Foreground="Gray"/>
                            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="120" Foreground="White" FontWeight="Bold"/>
                            <DataGridTextColumn Header="USER / ROLE" Binding="{Binding UserRole}" Width="150" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="*" Foreground="White"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
