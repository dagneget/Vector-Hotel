<UserControl x:Class="HRS.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:PaymentsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,20,30,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left List Area -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,30">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Billing &amp; Folios" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="PROCESS OUTSTANDING BILLS • TRANSACTION LOGS • INVOICES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <materialDesign:Card Width="300" Height="40" UniformCornerRadius="8" Background="{DynamicResource SurfaceContainerLowestBrush}" Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                     materialDesign:HintAssist.Hint="Search Guest / Room..."
                                     BorderThickness="0" 
                                     VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                        </Grid>
                    </materialDesign:Card>
                </StackPanel>
            </Grid>

            <!-- Data Grid -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                <Grid>
                    <DataGrid ItemsSource="{Binding Folios}" SelectedItem="{Binding SelectedFolio}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              BorderThickness="0" Background="Transparent" Margin="15" RowHeight="70">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,0,10,15"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="GUEST DETAIL" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Border Width="42" Height="42" Background="{DynamicResource DividerBrush}" CornerRadius="8" Margin="0,0,15,0">
                                                <materialDesign:PackIcon Kind="Receipt" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GuestName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ReservationId, StringFormat=FOLIO: {0}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ROOM" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TOTAL CHARGES" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalCharges, StringFormat=${0:N2}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="BALANCE DUE" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceDue, StringFormat=${0:N2}}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Slide-out Detail Panel: Folio View -->
        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"
                Width="480" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Guest Folio" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding SelectedFolio.ReservationId}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding SelectedFolio.GuestName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NocturnalAccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ledger / Line Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,15,0,15">
                        
                        <!-- Line Items Header -->
                        <Grid Margin="20,0,20,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="AMOUNT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <!-- Items Control (Converted to ListBox for selection) -->
                        <ListBox ItemsSource="{Binding FolioLineItems}" SelectedItem="{Binding SelectedLineItem}" Margin="20,0,20,0"
                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding IsPayment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat=MMM dd}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=${0:N2}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- Action Footer & Summary -->
                <Border Grid.Row="2" Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="0,0,12,12" Padding="20">
                    <StackPanel>
                        <!-- Totals -->
                        <StackPanel Margin="0,0,0,20">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Total Charges:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedFolio.TotalCharges, StringFormat=${0:N2}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Payments Received:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedFolio.TotalPayments, StringFormat=-${0:N2}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Separator Background="{DynamicResource DividerBrush}" Margin="0,5"/>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="Balance Due" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding FolioBalanceDue, StringFormat=${0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10" Visibility="{Binding IsAccountant, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="VERIFY PAYMENT" Command="{Binding VerifyPaymentCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource NocturnalAccentBrush}" BorderBrush="{DynamicResource NocturnalAccentBrush}" Margin="0,0,10,0"/>
                            
                            <Button Content="DOWNLOAD RECEIPT" Command="{Binding DownloadReceiptCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource DividerBrush}" Margin="0,0,10,0"/>
                                    
                            <Button Content="GENERATE INVOICE" Command="{Binding GenerateInvoiceCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource CardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="0" Height="36" materialDesign:ButtonAssist.CornerRadius="6" />
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="CANCEL" Command="{Binding CancelEditCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0"/>
                                    
                            <Button Content="PAY BY CASH" Command="{Binding PayCashCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#114D1A" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Bold"
                                    BorderThickness="0" Height="36" Margin="0,0,10,0" materialDesign:ButtonAssist.CornerRadius="6" />

                            <Button Content="PAY BY CARD" Command="{Binding PayCardCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource NocturnalAccentBrush}" Foreground="#111111" FontWeight="Bold"
                                    BorderThickness="0" Height="36" materialDesign:ButtonAssist.CornerRadius="6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
