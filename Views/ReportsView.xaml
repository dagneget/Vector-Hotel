<UserControl x:Class="HRS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:ReportsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- KPIs -->
            <RowDefinition Height="Auto" /> <!-- Charts & Insights -->
            <RowDefinition Height="Auto" /> <!-- Filters -->
            <RowDefinition Height="*" />    <!-- Table -->
        </Grid.RowDefinitions>

        <!-- 1. Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Financial Intelligence" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="REVENUE ANALYTICS • TAXATION • TRANSACTIONAL RECORDS" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" Opacity="0.7" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource MaterialDesignFlatButton}" Background="{DynamicResource LuminousAccentBrush}" Foreground="Black" FontWeight="Black" Height="45" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="GENERATE STATEMENT" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. KPI Dashboard -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Gross Revenue -->
            <Border Grid.Column="0" Style="{StaticResource LuminousCardStyle}">
                <StackPanel>
                    <TextBlock Text="GROSS REVENUE" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" />
                    <TextBlock Text="{Binding TotalRevenue}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource SuccessGreenBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ADR -->
            <Border Grid.Column="2" Style="{StaticResource LuminousCardStyle}">
                <StackPanel>
                    <TextBlock Text="ADR (AVG DAILY RATE)" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" />
                    <TextBlock Text="{Binding Adr}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- RevPAR -->
            <Border Grid.Column="4" Style="{StaticResource LuminousCardStyle}">
                <StackPanel>
                    <TextBlock Text="REVPAR" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" />
                    <TextBlock Text="{Binding RevPar}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Occupancy -->
            <Border Grid.Column="6" Style="{StaticResource LuminousCardStyle}" BorderBrush="{DynamicResource LuminousAccentBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="OCCUPANCY RATE" FontSize="10" FontWeight="Black" Foreground="{DynamicResource LuminousAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding OccupancyRate, StringFormat={}{0:P0}}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <materialDesign:PackIcon Kind="TrendingUp" Width="18" Height="18" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Charts & Insights Row -->
        <Grid Grid.Row="2" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Revenue Growth Chart -->
            <Border Grid.Column="0" Style="{StaticResource LuminousCardStyle}" Height="280">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="REVENUE TREND (LAST 7 DAYS)" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                    
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RevenueChartData}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Bottom" Margin="10,0">
                                    <Border Background="{DynamicResource LuminousAccentBrush}" Opacity="0.1" CornerRadius="6,6,0,0" />
                                    <Border Background="{DynamicResource LuminousAccentBrush}" Height="{Binding Percentage}" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" ToolTip="{Binding Value, StringFormat=C2}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding RevenueChartData}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Room Popularity -->
            <Border Grid.Column="2" Style="{StaticResource LuminousCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="REVENUE BY CATEGORY" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RoomPopularityData}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Value, StringFormat=C0}" FontSize="12" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Value}" Maximum="100000" Height="4" Margin="0,8,0,0" Foreground="{DynamicResource LuminousAccentBrush}" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Tax & Forecast -->
            <StackPanel Grid.Column="4">
                <Border Style="{StaticResource LuminousCardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="TAX LIABILITY (10%)" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding TaxAmount}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource DangerRedBrush}"/>
                        <TextBlock Text="NET INCOME" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                        <TextBlock Text="{Binding NetIncome}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource SuccessGreenBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="15" Padding="20">
                    <StackPanel>
                        <TextBlock Text="FUTURE BOOKINGS" FontSize="11" FontWeight="Black" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FutureBookingsCount}" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="RESERVATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 4. Filters & Search -->
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="All Time" IsChecked="True" Command="{Binding FilterCommand}" CommandParameter="All" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="0,0,10,0"/>
                <RadioButton Content="Today" Command="{Binding FilterCommand}" CommandParameter="Today" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="0,0,10,0"/>
                <RadioButton Content="This Week" Command="{Binding FilterCommand}" CommandParameter="Week" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="0,0,10,0"/>
                <RadioButton Content="This Month" Command="{Binding FilterCommand}" CommandParameter="Month" Style="{StaticResource MaterialDesignTabRadioButton}" Margin="0,0,10,0"/>
                <RadioButton Content="YTD" Command="{Binding FilterCommand}" CommandParameter="YTD" Style="{StaticResource MaterialDesignTabRadioButton}"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="10" Height="40" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                <Grid Width="250">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                             materialDesign:HintAssist.Hint="Search ID or guest..."
                             BorderThickness="0" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13">
                    </TextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Data Table -->
        <Border Grid.Row="4" Style="{StaticResource LuminousCardStyle}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <DataGrid ItemsSource="{Binding ReportData}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          BorderThickness="0" Background="Transparent" Margin="15" RowHeight="60">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="Black"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=MMM dd}" Width="80"/>
                        <DataGridTemplateColumn Header="GUEST" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GuestName}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="METHOD" Binding="{Binding Method}" Width="100"/>
                        <DataGridTemplateColumn Header="AMOUNT" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Amount, StringFormat=C2}" FontWeight="Black" Foreground="{DynamicResource SuccessGreenBrush}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Top Guests Sidebar -->
                <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Margin="0,15,15,15" CornerRadius="12" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="TOP GUESTS (VALUE)" FontSize="10" FontWeight="Black" Foreground="{DynamicResource LuminousAccentBrush}" Margin="0,0,0,15"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopGuests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding VisitCount, StringFormat={}{0} visits}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TotalSpent, StringFormat=C0}" FontWeight="Black" FontSize="12" Foreground="{DynamicResource SuccessGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
