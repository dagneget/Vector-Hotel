<UserControl x:Class="HRS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:ReportsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Financial Intelligence" FontSize="32" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="REVENUE ANALYTICS • TAXATION • TRANSACTIONAL RECORDS" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" Opacity="0.7" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="12" Height="45" Margin="0,0,15,0" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                    <Grid Width="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                                 materialDesign:HintAssist.Hint="Search records by ID or guest..."
                                 BorderThickness="0" 
                                 VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14">
                        </TextBox>
                    </Grid>
                </Border>

                <Button Style="{StaticResource MaterialDesignFlatButton}" Background="{DynamicResource LuminousAccentBrush}" Foreground="White" FontWeight="Black" Height="45" Padding="25,0" materialDesign:ButtonAssist.CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExport" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="EXPORT DATA" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Revenue Card -->
            <Border Grid.Column="0" Style="{StaticResource LuminousCardStyle}">
                <StackPanel>
                    <TextBlock Text="GROSS REVENUE" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding TotalRevenue}" FontSize="34" FontWeight="Black" Foreground="{DynamicResource SuccessGreenBrush}" />
                        <materialDesign:PackIcon Kind="ChartLine" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource SuccessGreenBrush}" Opacity="0.15" Width="40" Height="40" Margin="0,0,0,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Transaction Count Card -->
            <Border Grid.Column="2" Style="{StaticResource LuminousCardStyle}">
                <StackPanel>
                    <TextBlock Text="TRANSACTION VOLUME" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding TransactionCount}" FontSize="34" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <materialDesign:PackIcon Kind="History" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource LuminousAccentBrush}" Opacity="0.15" Width="40" Height="40" Margin="0,0,0,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System Info Card -->
            <Border Grid.Column="4" CornerRadius="15" Padding="25" BorderThickness="1" BorderBrush="{DynamicResource LuminousAccentBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F0F7FF" Offset="0" />
                        <GradientStop Color="#FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="FISCAL PERIOD" FontSize="11" FontWeight="Black" Foreground="{DynamicResource LuminousAccentBrush}" />
                    <TextBlock Text="FY 2026/27" FontSize="30" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="Q1 PERFORMANCE: EXCELENT" FontSize="10" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Black" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Transaction Data Table -->
        <Border Grid.Row="2" Style="{StaticResource LuminousCardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding ReportData}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0" Background="Transparent" Margin="20" RowHeight="75">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Black"/>
                        <Setter Property="Padding" Value="10,0,10,15"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="RECORD ID" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="10" Padding="15,8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PaymentId}" FontWeight="Black" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="BENEFICIARY" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="45" Height="45" CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}" Margin="0,0,15,0">
                                        <materialDesign:PackIcon Kind="AccountTie" Foreground="{DynamicResource LuminousAccentBrush}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GuestName}" FontWeight="Black" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="VERIFIED TRANSACTION" FontSize="10" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Black" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="EXECUTION DATE" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Date, StringFormat=MMM dd\, yyyy}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Time: 09:45 AM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="GATEWAY" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="15,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CreditCardOutline" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Method}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="EQUIVALENT AMOUNT" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Amount, StringFormat=${0:N2}}" FontWeight="Black" FontSize="18" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                    <TextBlock Text="SUCCESSFUL" FontSize="10" Foreground="{DynamicResource SuccessGreenBrush}" FontWeight="Black" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
