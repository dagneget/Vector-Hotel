<Window x:Class="HRS.Views.MainDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:HRS.ViewModels"
        xmlns:local="clr-namespace:HRS.Views"
        Title="NOCTURNAL - Grand Hotel" Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
        
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type viewmodels:CustomersViewModel}">
            <local:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReservationsViewModel}">
            <local:ReservationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <local:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RoomsViewModel}">
            <local:RoomsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PaymentsViewModel}">
            <local:PaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
            <local:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <local:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderThickness="0,0,1,0" BorderBrush="#1C1C1C">
            <Grid>
                <!-- Top Brand -->
                <StackPanel VerticalAlignment="Top" Margin="25,30,0,0">
                    <TextBlock Text="NOCTURNAL" FontSize="26" FontWeight="Heavy" FontStyle="Italic" Foreground="{DynamicResource NocturnalAccentBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="GRAND HOTEL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,40"/>
                    
                    <Button Command="{Binding NavigateDashboardCommand}" Height="45" Background="Transparent" BorderThickness="0" Margin="0,5,20,5" Padding="15,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="DASHBOARD" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Command="{Binding NavigateReservationsCommand}" Visibility="{Binding CanViewReservations, Converter={StaticResource BooleanToVisibilityConverter}}" Height="45" Background="Transparent" BorderThickness="0" Margin="0,5,20,5" Padding="15,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="RESERVATIONS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateRoomsCommand}" Visibility="{Binding CanViewRooms, Converter={StaticResource BooleanToVisibilityConverter}}" Height="45" Background="Transparent" BorderThickness="0" Margin="0,5,20,5" Padding="15,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <materialDesign:PackIcon Kind="BedSingleOutline" Width="22" Height="22" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="ROOMS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCustomersCommand}" Visibility="{Binding CanViewCustomers, Converter={StaticResource BooleanToVisibilityConverter}}" Height="45" Background="Transparent" BorderThickness="0" Margin="0,5,20,5" Padding="15,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="22" Height="22" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="CUSTOMERS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigatePaymentsCommand}" Visibility="{Binding CanViewPayments, Converter={StaticResource BooleanToVisibilityConverter}}" Height="45" Background="Transparent" BorderThickness="0" Margin="0,5,20,5" Padding="15,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <materialDesign:PackIcon Kind="CreditCardOutline" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="PAYMENTS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateReportsCommand}" Visibility="{Binding CanViewReports, Converter={StaticResource BooleanToVisibilityConverter}}" Height="45" Background="Transparent" BorderThickness="0" Margin="0,5,20,5" Padding="15,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="REPORTS" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Button -->
                <StackPanel VerticalAlignment="Bottom" Margin="25,0,25,30">
                    <Button Content="QUICK CHECK-IN" Visibility="{Binding CanViewReservations, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource NocturnalAccentBrush}" Foreground="#111111" FontWeight="Bold" Height="45" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="6" Margin="0,0,0,30" />
                    
                    <Button Command="{Binding NavigateSettingsCommand}" Visibility="{Binding CanViewSettings, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldAccount" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="USERS &amp; AUDIT LOGS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Height="40" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Width="100">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="LOG OUT" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" /> <!-- Top Header Bar -->
                <RowDefinition Height="*" />  <!-- Inner Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#1C1C1C" Background="{DynamicResource AppBackgroundBrush}">
                <Grid Margin="30,0">
                    <!-- Search Bar -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Width="400" Height="40" Background="#181818" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Margin="15,0">
                            <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBox BorderThickness="0" Background="Transparent" Foreground="White" Width="340" VerticalAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="Search guests, rooms, bookings..."/>
                        </StackPanel>
                    </Border>

                    <!-- Right Profile Actions -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Bell" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Cog" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="HelpCircleOutline" />
                        </Button>

                        <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold" FontSize="14" Foreground="White" TextAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource NocturnalAccentBrush}" TextAlignment="Right"/>
                        </StackPanel>

                        <Ellipse Width="40" Height="40" Fill="#282828" Stroke="{DynamicResource NocturnalAccentBrush}" StrokeThickness="2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Current Navigation View -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
