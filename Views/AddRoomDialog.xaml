<Window x:Class="HRS.Views.AddRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:HRS.ViewModels"
        mc:Ignorable="d"
        Title="Add New Room" 
        Height="850" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource AppBackgroundBrush}" 
            CornerRadius="20" 
            BorderThickness="1" 
            BorderBrush="{DynamicResource DividerBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" Color="Black" Opacity="0.25" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}" 
                    CornerRadius="20,20,0,0" 
                    Padding="30,25"
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{DynamicResource DividerBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ADD NEW ROOM" 
                                   FontSize="24" 
                                   FontWeight="Black" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="CREATE A NEW ROOM ASSET WITH COMPLETE DETAILS" 
                                   FontSize="11" 
                                   FontWeight="Black" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   Margin="0,6,0,0" 
                                   Opacity="0.8"/>
                    </StackPanel>
                    
                    <Button Command="{Binding CloseCommand}" 
                            HorizontalAlignment="Right"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="40" Height="40"
                            Padding="0">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        
                        <!-- Section 1: Basic Information -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="BASIC INFORMATION" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Room Number *" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="e.g. 101"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Floor Number *" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding FloorNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="e.g. 1"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Room Type / Category *" FontSize="11" FontWeight="Bold" Margin="0,15,0,5" Opacity="0.7"/>
                                <ComboBox ItemsSource="{Binding RoomTypeNames}" 
                                          SelectedItem="{Binding SelectedRoomTypeName}"
                                          materialDesign:HintAssist.Hint="Select room category"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Height="55" Padding="10,12"/>
                                
                                <!-- Custom Room Type Input (visible when Custom is selected) -->
                                <TextBox Text="{Binding CustomRoomTypeName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Enter custom room type name"
                                         Height="55" Padding="10,12"
                                         Margin="0,10,0,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRoomTypeName}" Value="Custom">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Room Size (m²)" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding RoomSize, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="e.g. 25"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Currency" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <ComboBox ItemsSource="{Binding Currencies}" 
                                                  SelectedItem="{Binding SelectedCurrency}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Width="100"
                                                  Height="55" Padding="10,12"/>
                                        <!-- Custom Currency Input -->
                                        <TextBox Text="{Binding CustomCurrency, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Custom currency"
                                                 Height="55" Padding="10,12"
                                                 Margin="0,10,0,0"
                                                 Width="100">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCurrency}" Value="Custom">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Capacity &amp; Bed Configuration -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="CAPACITY &amp; BED CONFIGURATION" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Max Occupancy" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding MaxOccupancy, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Guests"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="Number of Beds" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding NumberOfBeds, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Count"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Bed Type" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <ComboBox ItemsSource="{Binding BedTypes}" 
                                                  SelectedItem="{Binding SelectedBedType}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="55" Padding="10,12"/>
                                        <!-- Custom Bed Type Input -->
                                        <TextBox Text="{Binding CustomBedType, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Custom bed type"
                                                 Height="55" Padding="10,12"
                                                 Margin="0,10,0,0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedBedType}" Value="Custom">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>

                                <CheckBox IsChecked="{Binding HasExtraBed}" 
                                          Content="Extra Bed Available" 
                                          Margin="0,15,0,0"
                                          Style="{StaticResource MaterialDesignCheckBox}"/>
                                
                                <TextBox Text="{Binding ExtraBedPrice, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Extra Bed Price (optional)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="55" Padding="10,12"
                                         Margin="0,10,0,0"
                                         IsEnabled="{Binding HasExtraBed}"
                                         Opacity="{Binding HasExtraBed, Converter={StaticResource BooleanToOpacityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Pricing -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="PRICING" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Base Price per Night *" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                <TextBox Text="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="0.00"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Height="55" Padding="10,12"/>

                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Weekend Price" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding WeekendPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="0.00"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Holiday Price" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <TextBox Text="{Binding HolidayPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="0.00"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="55" Padding="10,12"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 4: Status &amp; Operations -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="STATUS &amp; OPERATIONS" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Availability" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <ComboBox ItemsSource="{Binding AvailabilityStatuses}" 
                                                  SelectedItem="{Binding SelectedAvailabilityStatus}"
                                                  Text="{Binding SelectedAvailabilityStatus, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="55" Padding="10,12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Cleaning Status" FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                                        <ComboBox ItemsSource="{Binding CleaningStatuses}" 
                                                  SelectedItem="{Binding SelectedCleaningStatus}"
                                                  Text="{Binding SelectedCleaningStatus, Mode=TwoWay}"
                                                  IsEditable="True"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="55" Padding="10,12"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Maintenance Status" FontSize="11" FontWeight="Bold" Margin="0,15,0,5" Opacity="0.7"/>
                                <ComboBox ItemsSource="{Binding MaintenanceStatuses}" 
                                          SelectedItem="{Binding SelectedMaintenanceStatus}"
                                          Text="{Binding SelectedMaintenanceStatus, Mode=TwoWay}"
                                          IsEditable="True"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Height="55" Padding="10,12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                        
                        <!-- Section 5: Room Features / Amenities -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="ROOM FEATURES &amp; AMENITIES" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <!-- Basic -->
                                <TextBlock Text="BASIC" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,15">
                                    <CheckBox IsChecked="{Binding HasWifi}" Content="Wi-Fi" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasAC}" Content="Air Conditioning" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasTV}" Content="TV" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasPhone}" Content="Telephone" Margin="0,0,0,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </WrapPanel>

                                <!-- Bathroom -->
                                <TextBlock Text="BATHROOM" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,15">
                                    <CheckBox IsChecked="{Binding HasPrivateBathroom}" Content="Private" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasShower}" Content="Shower" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasBathtub}" Content="Bathtub" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasHotWater}" Content="Hot Water" Margin="0,0,0,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </WrapPanel>

                                <!-- Furniture -->
                                <TextBlock Text="FURNITURE" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,15">
                                    <CheckBox IsChecked="{Binding HasDesk}" Content="Desk" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasChair}" Content="Chair" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasWardrobe}" Content="Wardrobe" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasMirror}" Content="Mirror" Margin="0,0,0,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </WrapPanel>

                                <!-- Extras -->
                                <TextBlock Text="EXTRAS" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,15">
                                    <CheckBox IsChecked="{Binding HasMinibar}" Content="Mini Bar" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasRefrigerator}" Content="Refrigerator" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasCoffeeMaker}" Content="Coffee/Tea" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasSafe}" Content="Safe Box" Margin="0,0,0,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </WrapPanel>

                                <!-- Special -->
                                <TextBlock Text="SPECIAL" FontSize="10" FontWeight="Black" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <CheckBox IsChecked="{Binding HasBalcony}" Content="Balcony" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasSeaView}" Content="Sea View" Margin="0,0,15,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding HasCityView}" Content="City View" Margin="0,0,0,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 6: Additional Attributes -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="ADDITIONAL ATTRIBUTES" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <WrapPanel>
                                    <CheckBox IsChecked="{Binding SmokingAllowed}" Content="Smoking Allowed" Margin="0,0,20,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <CheckBox IsChecked="{Binding WheelchairAccessible}" Content="Wheelchair Accessible" Margin="0,0,0,5" Style="{StaticResource MaterialDesignCheckBox}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section 7: Media -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="ROOM IMAGES" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <Button Command="{Binding UploadImagesCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="50"
                                        BorderBrush="{DynamicResource LuminousAccentBrush}"
                                        Foreground="{DynamicResource LuminousAccentBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="UPLOAD IMAGES" FontWeight="Black"/>
                                    </StackPanel>
                                </Button>

                                <!-- Image Preview Area -->
                                <Border Background="{DynamicResource AppBackgroundBrush}" 
                                        CornerRadius="10" 
                                        Height="100"
                                        Margin="0,15,0,0"
                                        BorderThickness="1" 
                                        BorderBrush="{DynamicResource DividerBrush}">
                                    <Grid>
                                        <!-- Show when no images -->
                                        <TextBlock Text="No images selected" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Opacity="0.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedImagePaths.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Show images when selected -->
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Margin="10,5">
                                            <ItemsControl ItemsSource="{Binding SelectedImagePaths}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource DividerBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="5"
                                                                Margin="5,0"
                                                                Width="80" 
                                                                Height="80">
                                                            <Image Source="{Binding}" 
                                                                   Stretch="UniformToFill"
                                                                   Margin="2"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 8: Notes -->
                        <Border Background="{DynamicResource SidebarBackgroundBrush}" 
                                CornerRadius="15" 
                                Padding="20" 
                                Margin="0,0,0,20"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <TextBlock Text="INTERNAL NOTES" 
                                           FontWeight="Black" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource LuminousAccentBrush}"
                                           Margin="0,0,0,15"/>
                                
                                <TextBox Text="{Binding StaffNotes}"
                                         materialDesign:HintAssist.Hint="Staff notes and internal comments..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Height="100" Padding="10,12"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBackgroundBrush}" 
                    CornerRadius="0,0,20,20" 
                    Padding="30,20"
                    BorderThickness="0,1,0,0" 
                    BorderBrush="{DynamicResource DividerBrush}">
                <Grid>
                    <Button Content="CANCEL" 
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            HorizontalAlignment="Left"
                            Height="50"
                            Padding="30,0"
                            materialDesign:ButtonAssist.CornerRadius="12"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="SAVE AS DRAFT" 
                                Command="{Binding SaveDraftCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{DynamicResource LuminousAccentBrush}"
                                Foreground="{DynamicResource LuminousAccentBrush}"
                                Margin="0,0,15,0"
                                Height="50"
                                Padding="30,0"
                                materialDesign:ButtonAssist.CornerRadius="12"/>
                        
                        <Button Content="CREATE ROOM" 
                                Command="{Binding CreateRoomCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Background="{DynamicResource LuminousAccentBrush}"
                                Foreground="White"
                                FontWeight="Black"
                                Height="50"
                                Padding="40,0"
                                materialDesign:ButtonAssist.CornerRadius="12">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource AllValuesFilledConverter}">
                                    <Binding Path="RoomNumber"/>
                                    <Binding Path="FloorNumber"/>
                                    <Binding Path="BasePrice"/>
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
