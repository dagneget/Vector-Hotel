<UserControl x:Class="HRS.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:HRS.ViewModels"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
             TextOptions.TextFormattingMode="Ideal"
             Background="Transparent">

    <UserControl.DataContext>
        <viewmodels:ReservationsViewModel />
    </UserControl.DataContext>

    <Grid Margin="30,20,30,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Main Left Block (List & Metrics) -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header Text -->
                <RowDefinition Height="Auto" /> <!-- Metric Cards -->
                <RowDefinition Height="*" />    <!-- Data Grid -->
            </Grid.RowDefinitions>

            <!-- Top Header Area -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reservations" FontSize="28" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding SummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#181818" CornerRadius="8" Height="40" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal" Margin="15,0">
                            <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBox BorderThickness="0" Background="Transparent" Foreground="White" Width="200" VerticalAlignment="Center" FontSize="14" materialDesign:HintAssist.Hint="Global Search..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="+ NEW BOOKING" 
                            Background="{DynamicResource NocturnalAccentBrush}" Foreground="#111111" FontWeight="Bold"
                            BorderThickness="0" Height="40" Padding="20,0" materialDesign:ButtonAssist.CornerRadius="6"
                            Command="{Binding NewReservationCommand}" />
                </StackPanel>
            </Grid>

            <!-- Metrics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#252525">
                    <StackPanel>
                        <TextBlock Text="OCCUPANCY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid Margin="0,15,0,0">
                            <TextBlock Text="{Binding OccupancyText}" FontSize="36" FontWeight="Bold" Foreground="White" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <materialDesign:PackIcon Kind="TrendingUp" Foreground="{DynamicResource SuccessGreenBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OccupancyTrend}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#252525">
                    <StackPanel>
                        <TextBlock Text="DAILY REV" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid Margin="0,15,0,0">
                            <TextBlock Text="{Binding DailyRevText}" FontSize="36" FontWeight="Bold" Foreground="White" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <materialDesign:PackIcon Kind="TrendingUp" Foreground="{DynamicResource SuccessGreenBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DailyRevTrend}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#252525">
                    <StackPanel>
                        <TextBlock Text="PENDING" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid Margin="0,15,0,0">
                            <TextBlock Text="{Binding PendingCount}" FontSize="36" FontWeight="Bold" Foreground="White" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#33FF4B4B" CornerRadius="4" Padding="6,2" Margin="0,0,0,5">
                                <TextBlock Text="URGENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerRedBrush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#353535">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A1A1A" Offset="0" />
                            <GradientStop Color="#252525" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="SYSTEM HEALTH" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Cloud Sync Active" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,5" />
                        <TextBlock Text="LAST UPDATED: 2M AGO" FontSize="10" Foreground="Gray" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Data Grid -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#252525">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,20,5">
                        <RadioButton Content="ALL BOOKINGS" Style="{StaticResource MaterialDesignTabRadioButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0" IsChecked="True" Command="{Binding ChangeSegmentCommand}" CommandParameter="All"/>
                        <RadioButton Content="TODAY'S ARRIVALS" Style="{StaticResource MaterialDesignTabRadioButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0" Command="{Binding ChangeSegmentCommand}" CommandParameter="Arrivals"/>
                        <RadioButton Content="IN-HOUSE GUESTS" Style="{StaticResource MaterialDesignTabRadioButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0" Command="{Binding ChangeSegmentCommand}" CommandParameter="InHouse"/>
                        <RadioButton Content="TODAY'S DEPARTURES" Style="{StaticResource MaterialDesignTabRadioButton}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,15,0" Command="{Binding ChangeSegmentCommand}" CommandParameter="Departures"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              BorderThickness="0" Background="Transparent" Margin="15" RowHeight="60">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,0,10,15"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="GUEST NAME" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5,0">
                                            <Ellipse Width="35" Height="35" Fill="#3382ABFF" Margin="0,0,15,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                                <TextBlock Text="MEMBER" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ROOM" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="5,0">
                                            <TextBlock Text="{Binding RoomNumber}" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="CHECK IN / OUT" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="5,0">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="White">
                                                <Run Text="{Binding CheckInDate, Mode=OneWay, StringFormat=MMM dd}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding CheckOutDate, Mode=OneWay, StringFormat=MMM dd}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="STATUS" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReservationStatus}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessGreenBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TOTAL" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalPrice, StringFormat=C}" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Slide-out Detail Panel -->
        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource CardBackgroundBrush}" 
                CornerRadius="12" BorderThickness="1" BorderBrush="#252525"
                Width="450" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#252525" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Reservation Details" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Enter booking and room assignment info." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable Form -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="25,20">
                        <TextBlock Text="Guest Information" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource NocturnalAccentBrush}" Margin="0,0,0,15"/>
                        
                        <ComboBox ItemsSource="{Binding CustomersList}" SelectedItem="{Binding FormSelectedCustomer}" 
                                  DisplayMemberPath="FullName"
                                  materialDesign:HintAssist.Hint="Type Name to Search Guest *" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,25"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  Text="{Binding GuestSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Stay Dates" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource NocturnalAccentBrush}" Margin="0,10,0,15"/>

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding FormCheckInDate}" materialDesign:HintAssist.Hint="Check-In *" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                            <DatePicker Grid.Column="2" SelectedDate="{Binding FormCheckOutDate}" materialDesign:HintAssist.Hint="Check-Out *" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                        </Grid>

                        <TextBlock Text="Room Assignment" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource NocturnalAccentBrush}" Margin="0,10,0,15"/>
                        
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding RoomTypesList}" SelectedItem="{Binding FormSelectedRoomType}"
                                      DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Room Type *" Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                            
                            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableRoomsList}" SelectedItem="{Binding FormSelectedRoom}"
                                      DisplayMemberPath="RoomNumber" materialDesign:HintAssist.Hint="Room Number *" Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                        </Grid>

                        <TextBlock Text="Occupancy &amp; Status" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource NocturnalAccentBrush}" Margin="0,10,0,15"/>

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FormAdultsCount}" materialDesign:HintAssist.Hint="Adults" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding FormStatus}"
                                      materialDesign:HintAssist.Hint="Status" Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                        </Grid>

                        <TextBox Text="{Binding FormNotes}" materialDesign:HintAssist.Hint="Special Requests / Notes" 
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="0,0,0,25"/>

                        <Border Background="#1A82ABFF" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Total Cost:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding FormTotalPrice, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Footer -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#252525" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="DELETE" Command="{Binding DeleteCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource DangerRedBrush}" Margin="0,0,40,0"/>

                        <Button Content="CANCEL" Command="{Binding CancelEditCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#353535" Foreground="White" Margin="0,0,10,0"/>
                                
                        <Button Content="SAVE BOOKING" Command="{Binding SaveCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource NocturnalAccentBrush}" Foreground="#111111" FontWeight="Bold" BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="6" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
